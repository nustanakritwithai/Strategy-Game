func text(key: String, extra: Dictionary = {}) -> String:
	var table: Dictionary = STR.get(lang, STR["en"])
	var raw := str(table.get(key, STR["en"].get(key, key)))
	for slot in extra:
		raw = raw.replace("{%s}" % slot, str(extra[slot]))
	return raw


func set_lang(next: String) -> void:
	lang = "en" if next == "en" else "th"
